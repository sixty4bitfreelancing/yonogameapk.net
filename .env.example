# Copy to .env.local (or set in your host's environment settings), then rebuild.

# One link for every game's Download button. Leave empty to show "Download not available yet".
DOWNLOAD_URL=

# "true" if DOWNLOAD_URL is an affiliate or referral link: buttons get rel="sponsored"
# and the site shows an affiliate disclosure.
DOWNLOAD_URL_SPONSORED=false

# Your Yono Games Telegram channel, e.g. https://t.me/yourchannel (used on /telegram/).
TELEGRAM_URL=
